generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CHOFER
  RECEPCION
  ADMIN
  VENTAS  // Encargada de Ventas — módulo CRM
  BODEGA  // Bodeguero encargado — módulo Inventario
}

enum PickupOrderStatus {
  BORRADOR
  EN_RETIRO
  EN_TRANSITO
  RECIBIDA
  DISCREPANCIA
  CERRADA
}

enum EvidenceStage {
  RETIRO
  RECEPCION
}

enum DiscrepancySeverity {
  MENOR
  MODERADA
  GRAVE
}

enum DiscrepancyStatus {
  PENDIENTE
  EN_INVESTIGACION
  RESUELTA
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersAsDriver    PickupOrder[] @relation("Driver")
  evidencesUploaded Evidence[]   @relation("Uploader")
  discrepanciesFound Discrepancy[] @relation("DetectedBy")
  discrepanciesResolved Discrepancy[] @relation("ResolvedBy")
  trackers              Tracker[]
  inventoryMovements    InventoryMovement[] @relation("InventoryMovementBy")
  activitiesCreated     Activity[] @relation("ActivityCreatedBy")

  @@index([email])
  @@index([role, isActive])
}

model Company {
  id           String   @id @default(cuid())
  name         String
  address      String?
  contactName  String?
  contactPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders     PickupOrder[]
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  @@index([isActive])
}

model MaterialType {
  id       String  @id @default(cuid())
  name     String
  unit     String  @default("kg")
  isActive Boolean @default(true)

  items OrderItem[]

  @@index([isActive])
}

model PickupOrder {
  id                String            @id @default(cuid())
  orderCode         String            @unique
  status            PickupOrderStatus @default(BORRADOR)

  driverId  String
  driver    User    @relation("Driver", fields: [driverId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  pickupAt            DateTime?
  deliveredAt         DateTime?
  pickupLat           Float?
  pickupLng           Float?
  clientSignerName    String?
  signatureImagePath  String?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  evidences     Evidence[]
  discrepancies Discrepancy[]

  @@index([driverId, status])
  @@index([status])
  @@index([orderCode])
  @@index([createdAt])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            PickupOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  materialTypeId   String
  materialType     MaterialType @relation(fields: [materialTypeId], references: [id])

  materialName     String  // snapshot del nombre al momento del retiro
  declaredQuantity Float
  receivedQuantity Float?
  unit             String

  @@index([orderId])
}

model Evidence {
  id           String        @id @default(cuid())
  orderId      String
  order        PickupOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stage        EvidenceStage
  imagePath    String
  takenAt      DateTime      @default(now())
  lat          Float?
  lng          Float?

  uploadedById String
  uploadedBy   User          @relation("Uploader", fields: [uploadedById], references: [id])

  @@index([orderId])
}

model Discrepancy {
  id          String              @id @default(cuid())
  orderId     String
  order       PickupOrder         @relation(fields: [orderId], references: [id])

  orderItemId    String?
  materialType   String?
  declaredQuantity Float?
  receivedQuantity Float?
  differencePercent Float?

  severity    DiscrepancySeverity
  status      DiscrepancyStatus   @default(PENDIENTE)
  description String?

  detectedById String
  detectedBy   User    @relation("DetectedBy", fields: [detectedById], references: [id])

  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?   @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderId])
}

// Counter for auto-incrementing order codes
model OrderCounter {
  id    String @id @default("singleton")
  count Int    @default(0)
}

enum TrackerType {
  USUARIO
  DISPOSITIVO
}

enum TrackerKind {
  CHOFER
  RECICLADOR
}

model Tracker {
  id        String      @id @default(cuid())
  label     String
  type      TrackerType
  kind      TrackerKind
  isActive  Boolean     @default(true)

  userId    String?     @unique
  user      User?       @relation(fields: [userId], references: [id])

  deviceKey String?     @unique

  positions Position[]
  createdAt DateTime    @default(now())

  @@index([kind, isActive])
}

model Position {
  id         String   @id @default(cuid())
  trackerId  String
  tracker    Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  lat        Float
  lng        Float
  accuracy   Float?
  source     String
  recordedAt DateTime @default(now())

  @@index([trackerId, recordedAt])
}

// ── Inventario (módulo Bodega) ──────────────────────────────────────────────

enum InventoryCategory {
  MATERIA_PRIMA
  PALLET
  OTRO
}

enum MovementType {
  ENTRADA // suma cantidad
  SALIDA  // resta cantidad
  AJUSTE  // fija la cantidad a un valor exacto (conteo físico)
}

model InventoryItem {
  id        String             @id @default(cuid())
  name      String
  category  InventoryCategory  @default(OTRO)
  quantity  Float              @default(0)
  unit      String             @default("kg")
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  movements InventoryMovement[]

  @@index([isActive])
  @@index([category])
}

model InventoryMovement {
  id       String        @id @default(cuid())
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  type     MovementType
  quantity Float
  reason   String?

  userId   String
  user     User          @relation("InventoryMovementBy", fields: [userId], references: [id])

  createdAt DateTime     @default(now())

  @@index([itemId, createdAt])
}

// ── CRM (módulo Ventas) ──────────────────────────────────────────────────────
// Todo cuelga de Company: un contacto, deal o actividad siempre pertenece a
// una empresa real del sistema — no hay un universo de leads paralelo.

enum ContactTemperature {
  FRIO
  TIBIO
  CALIENTE
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  role        String? // cargo dentro de la empresa
  email       String?
  phone       String?
  notes       String?
  isActive    Boolean            @default(true)
  temperature ContactTemperature @default(FRIO)
  score       Int                @default(0) // 0-100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals      Deal[]
  activities Activity[]

  @@index([companyId])
  @@index([temperature])
}

model PipelineStage {
  id     String  @id @default(cuid())
  name   String
  order  Int
  color  String  @default("#64748b")
  isWon  Boolean @default(false)
  isLost Boolean @default(false)

  deals Deal[]

  @@index([order])
}

model Deal {
  id          String @id @default(cuid())
  title       String
  value       Float  @default(0)
  probability Int    @default(0) // 0-100

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id])

  expectedClose DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@index([companyId])
  @@index([stageId])
}

enum ActivityType {
  LLAMADA
  EMAIL
  REUNION
  NOTA
  SEGUIMIENTO
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  description String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  scheduledAt DateTime?
  completedAt DateTime?

  createdById String
  createdBy   User   @relation("ActivityCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
}
