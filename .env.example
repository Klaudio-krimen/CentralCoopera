# Copiar a .env.local y completar fuera de Git. Ver VARIABLES_ENTORNO.md.
# Prisma CLI requiere cargar DATABASE_URL/DIRECT_URL en el mismo shell.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./public/uploads"
MAX_PHOTO_SIZE_MB=1
MAX_PHOTOS_PER_ORDER=5
DISCREPANCY_THRESHOLD_PERCENT=2

APIFY_TOKEN=""
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Coopera Pro"
SMTP_REPLY_TO=""

CRON_SECRET=""
OUTREACH_DAILY_CAP=25
OUTREACH_PUBLIC_URL=""
OUTREACH_PDF_BLOB_URL=""
OUTREACH_SENDER_LEGAL_NAME=""
OUTREACH_SENDER_RUT=""
OUTREACH_SENDER_ADDRESS=""

# Clave AES-256 base64; conservarla en un gestor antes de cifrar cuentas.
